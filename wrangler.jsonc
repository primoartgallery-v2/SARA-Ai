{
  "name": "sara-ai",
  "compatibility_date": "2024-09-24",
  "main": "src/index.ts",
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-ai-db",
      "database_id": "656b2471-72ff-4275-9b0b-acdb3c98441f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "d2e6fbd9cd074315a243c4a6c0598293"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "DEFAULT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "FAST_MODEL": "@cf/zai-org/glm-4.7-flash",
    "THINKING_MODEL": "@cf/deepseek-ai/deepseek-r1-distill-qwen-32b",
    "CREATOR_NAME": "Manik"
  }
}
